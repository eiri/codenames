{
  "name": "codenames",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint -c eslint.config.ts src",
    "dev-test": "vitest --reporter=basic --disable-console-intercept",
    "preview": "vite preview",
    "convert": "node ./assets/convert.js ./assets/ACB_codenames.txt ./src/assets/words.json",
    "encrypt": "node --import=specifier-resolution-node/register ./assets/encrypt.js"
  },
  "dependencies": {
    "@fontsource-variable/playfair": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "ably": "^2.5.0",
    "animate.css": "^4.1.1",
    "crypto-es": "^3.1.3",
    "pinia": "^4.0.3",
    "specifier-resolution-node": "^1.1.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "^6"
    }
  }
}
