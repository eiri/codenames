{
  "name": "codenames",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "dev:worker": "npm run build && wrangler dev --local",
    "credentials": "node scripts/credentials.mjs",
    "deploy": "npm run build && wrangler deploy",
    "build": "vite build",
    "test": "vitest run",
    "check:room": "node scripts/check-room.mjs",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "lint": "eslint -c eslint.config.ts src worker",
    "dev-test": "vitest --reporter=basic --disable-console-intercept",
    "preview": "vite preview",
    "convert": "node ./assets/convert.js ./assets/ACB_codenames.txt ./src/assets/words.json"
  },
  "dependencies": {
    "@fontsource-variable/playfair": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "animate.css": "^4.1.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.0.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0",
    "ws": "^8.22.2"
  },
  "overrides": {
    "typescript-eslint": {
      "typescript": "^6"
    }
  }
}
